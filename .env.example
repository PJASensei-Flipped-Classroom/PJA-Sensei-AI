# --- LLM (OpenAI-compatible: Ollama / LM Studio) ---
# Domyślnie lokalne Ollama — zero limitów RPM, prywatność, stabilne live.
# Po zmianie modeli / URL zrestartuj uvicorn (stałe ładowane przy imporcie).
#
# Setup Ollama:
#   ollama pull qwen2.5-coder:7b
#   ollama serve
#
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
MAIN_MODEL=qwen2.5-coder:7b
SECURITY_MODEL=qwen2.5-coder:7b
# Puste lokalnie; opcjonalny drugi model po 429 dostawcy.
MAIN_MODEL_FALLBACK=

# Aliasy (opcjonalne): BASE_URL, API_KEY, MODEL
#
# LM Studio:
#   LLM_BASE_URL=http://127.0.0.1:1234/v1
#   LLM_API_KEY=lm-studio
#   MAIN_MODEL=<nazwa z LM Studio>
#
# Docker Compose → Ollama na hoście (Windows/Mac):
#   LLM_BASE_URL=http://host.docker.internal:11434/v1

# --- Webhooks (opcjonalne) ---
# Puste = wyłączone (brak POST i brak warningów 404 w logu).
# Ustaw URL Springa, np. http://localhost:8080/api/ai/telemetry
# SUMMARY_WEBHOOK_URL bez wartości = TELEMETRY_URL
TELEMETRY_URL=
SUMMARY_WEBHOOK_URL=

# --- HTTP ---
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500,null

# --- Auth (gdy AI_AUTH_ENABLED=true, ustaw niepusty AI_JWT_SECRET) ---
AI_AUTH_ENABLED=false
AI_JWT_SECRET=
AI_JWT_ALGORITHM=HS256

# --- Limity / cache / sesje in-memory ---
RATE_LIMIT_PER_MINUTE=30
CACHE_TTL_SECONDS=1800
CACHE_MAX_ENTRIES=500
CONVERSATION_TTL_SECONDS=7200
MAX_CONVERSATIONS=200

# --- Security gate ---
# true = blokuj chat gdy LLM security nie odpowie
SECURITY_FAIL_CLOSED=false
