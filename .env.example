# --- LLM (wymagane do czatu / live) ---
# Domyślnie modele :free (bez kredytu OpenRouter). Wspólna pula może dać 429.
# Nie używaj openrouter/free do czatu — losuje modele bez JSON/response_format.
# Płatne (stabilniejsze limity): google/gemini-2.5-flash + kredyt na openrouter.ai/settings/credits
# Po zmianie modeli zrestartuj uvicorn (stałe ładowane przy imporcie).
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MAIN_MODEL=google/gemma-4-31b-it:free
SECURITY_MODEL=liquid/lfm-2.5-2.6b:free
# Po 429: retry, potem fallback z INNEGO providera (nie Google — ta sama pula co Gemma).
MAIN_MODEL_FALLBACK=nex-agi/nex-n2.5-mini:free

# --- Webhooks (opcjonalne) ---
# Puste = wyłączone (brak POST i brak warningów 404 w logu).
# Ustaw URL Springa, np. http://localhost:8080/api/ai/telemetry
# SUMMARY_WEBHOOK_URL bez wartości = TELEMETRY_URL
TELEMETRY_URL=
SUMMARY_WEBHOOK_URL=

# --- HTTP ---
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500,null

# --- Auth (gdy AI_AUTH_ENABLED=true, ustaw niepusty AI_JWT_SECRET) ---
AI_AUTH_ENABLED=false
AI_JWT_SECRET=
AI_JWT_ALGORITHM=HS256

# --- Limity / cache / sesje in-memory ---
RATE_LIMIT_PER_MINUTE=30
CACHE_TTL_SECONDS=1800
CACHE_MAX_ENTRIES=500
CONVERSATION_TTL_SECONDS=7200
MAX_CONVERSATIONS=200

# --- Security gate ---
# true = blokuj chat gdy LLM security nie odpowie
SECURITY_FAIL_CLOSED=false
