# LLM Configuration
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
MAIN_MODEL=qwen2.5-coder:7b
SECURITY_MODEL=qwen2.5-coder:7b

# Sacurity and Rate limitation
AI_AUTH_ENABLED=false
AI_JWT_SECRET=supersecret-dev-key
RATE_LIMIT_PER_MINUTE=60
CONVERSATION_TTL_SECONDS=7200

# Cache
CACHE_SIZE=1000
CACHE_TTL=3600

# Integration
TELEMETRY_URL=
SUMMARY_WEBHOOK_URL=

# Network
CORS_ORIGINS=["*"]
TRUST_X_FORWARDED_FOR=true
SECURITY_FAIL_CLOSED=true