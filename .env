# LLM Configuration
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
MAIN_MODEL=qwen2.5-coder:7b
SECURITY_MODEL=qwen2.5-coder:7b

# Local playground (auth off; UI/docs on). Production: see .env.example
AI_AUTH_ENABLED=false
AI_JWT_SECRET=supersecret-dev-key-at-least-32b
AI_JWT_AUDIENCE=pja-sensei-ai
AI_JWT_ISSUER=pja-spring
AI_EXPOSE_DOCS=true
AI_EXPOSE_UI=true
RATE_LIMIT_PER_MINUTE=60
CONVERSATION_TTL_SECONDS=7200
# Local playground: 0 so /scenarios S4 can fire two IDE events immediately.
# Production / realism: use 15 (anti hint-farming). Pytest forces 0 via conftest.
FRUSTRATION_EVENT_COOLDOWN_SECONDS=0

# Cache
CACHE_SIZE=1000
CACHE_TTL_SECONDS=3600

# Integration
TELEMETRY_URL=
SUMMARY_WEBHOOK_URL=

# Network — local CORS open for tester UI
CORS_ORIGINS=["*"]
TRUST_X_FORWARDED_FOR=false
SECURITY_FAIL_CLOSED=true
SECURITY_ALWAYS_CLASSIFY=false
