  "components": {
    "schemas": {
      "AgentBehavior": {
        "properties": {
          "persona": {
            "$ref": "#/components/schemas/AgentPersona"
          },
          "codeRevealFallback": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Coderevealfallback"
          },
          "strictRules": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Strictrules"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "mode": {
            "type": "string",
            "enum": [
              "theory",
              "debug",
              "review"
            ],
            "title": "Mode",
            "default": "debug"
          }
        },
        "type": "object",
        "required": [
          "persona"
        ],
        "title": "AgentBehavior"
      },
      "AgentPersona": {
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1,
            "title": "Role"
          },
          "tone": {
            "type": "string",
            "minLength": 1,
            "title": "Tone"
          }
        },
        "type": "object",
        "required": [
          "role",
          "tone"
        ],
        "title": "AgentPersona"
      },
      "Checkpoint": {
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "title": "Id"
          },
          "afterGoal": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Aftergoal"
          },
          "hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hint"
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "Checkpoint"
      },
      "CodeContext": {
        "properties": {
          "currentFileName": {
            "type": "string",
            "minLength": 1,
            "title": "Currentfilename"
          },
